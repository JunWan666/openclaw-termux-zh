# Flutter/Dart
.dart_tool/
.packages
.pub/
build/
*.iml

# Android
android/.gradle/
android/app/build/
android/local.properties
android/key.properties
*.jks
*.keystore

# PRoot binaries (fetched by script, not committed)
# Native PRoot binaries are provisioned locally, but the small compatibility
# shim below is source-controlled because PRoot cannot start without it.
android/app/src/main/jniLibs/*/*
!android/app/src/main/jniLibs/*/libandroid-shmem.so

# IDE
.idea/
.vscode/
*.swp
